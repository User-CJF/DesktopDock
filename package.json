{
  "name": "desktopdock",
  "version": "0.3.0",
  "private": true,
  "description": "Windows-native desktop launcher and organizer",
  "author": "DesktopDock Contributors",
  "main": "src/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "smoke": "node scripts/smoke.cjs",
    "test:index": "node --test tests/app-index.test.cjs",
    "test:icons": "node --test tests/icon-cache.test.cjs",
    "check": "node --check src/main/index.cjs && node --check src/preload/index.cjs && node --check final/sidebar.js && node --test tests/*.test.cjs && vite build",
    "pack:win": "vite build && electron-builder --win --dir",
    "dist:win": "vite build && electron-builder --win nsis",
    "portable:win": "vite build && electron-builder --win portable"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "vue": "3.5.42",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "cn.desktopdock.app",
    "productName": "DesktopDock",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "beforeBuild": "scripts/skip-runtime-dependencies.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/DesktopDock.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "DesktopDock-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "DesktopDock.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
